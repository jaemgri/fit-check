<div class="page">
  <header class="page-header">
    <span class="brand">FitCheck</span>
    <h1>The Studio</h1>
  </header>

  <%= form_with model: @tryon, url: tryons_path, local: true, html: { multipart: true, class: "tryon-form" } do |f| %>
    <% if @tryon.errors.any? %>
      <ul class="errors">
        <% @tryon.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    <% end %>

    <div class="name-field">
      <%= f.text_field :name, placeholder: "Name this fit (optional)" %>
    </div>

    <div class="studio-card">
      <h3 class="card-title">Your Base Photo</h3>

      <% if current_user.base_photo.attached? %>
        <div class="mode-buttons">
          <button type="button" class="mode-btn upload-style active" id="use-saved-btn">Use My Photo</button>
          <button type="button" class="mode-btn camera-style" id="use-new-btn">Take New Photo</button>
        </div>
        <input type="hidden" name="person_photo_source" id="person_photo_source" value="saved">

        <div class="saved-photo-preview" id="saved-photo-preview">
          <%= image_tag current_user.base_photo, class: "saved-preview-img" %>
        </div>
      <% else %>
        <input type="hidden" name="person_photo_source" value="new">
      <% end %>

      <div class="photo-field" data-field="person" id="person-photo-field" <%= "style=display:none;".html_safe if current_user.base_photo.attached? %>>
        <div class="upload-mode">
          <div class="dropzone">
            <span class="dropzone-icon">👤</span>
            <span class="dropzone-text">Click or drag a photo here</span>
            <img class="preview" style="display:none;">
          </div>
        </div>
        <div class="camera-mode" style="display:none;">
          <video autoplay playsinline muted></video>
          <canvas hidden></canvas>
          <img class="camera-preview" style="display:none;">
          <button type="button" class="capture-btn">Capture</button>
        </div>
        <input type="file" name="tryon[person_photo]" accept="image/*" class="real-file-input" hidden>
        <div class="mode-buttons">
          <button type="button" class="mode-btn camera-style" data-mode="camera">Take Photo 📸</button>
          <button type="button" class="mode-btn upload-style active" data-mode="upload">Upload from Gallery 🖼</button>
        </div>
      </div>

      <label class="save-base-checkbox">
        <%= check_box_tag :save_as_base_photo, "1", !current_user.base_photo.attached? %>
        Save this as my photo for next time
      </label>

      <p class="card-caption">For best results, use good lighting and a simple background.</p>
    </div>

    <div class="studio-card">
      <h3 class="card-title">The Garment</h3>
      <div class="clothing-items" id="clothing-items"></div>
      <button type="button" class="add-item-btn" id="add-item-btn">+ Add another item</button>
      <p class="card-caption">For best results, use good lighting and a simple background.</p>
    </div>

    <template id="clothing-item-template">
      <div class="photo-field clothing-item" data-field="clothing">
        <button type="button" class="remove-item-btn">&times;</button>
        <div class="upload-mode">
          <div class="dropzone">
            <span class="dropzone-icon">🧥</span>
            <span class="dropzone-text">Click or drag a photo here</span>
            <img class="preview" style="display:none;">
          </div>
        </div>
        <div class="camera-mode" style="display:none;">
          <video autoplay playsinline muted></video>
          <canvas hidden></canvas>
          <img class="camera-preview" style="display:none;">
          <button type="button" class="capture-btn">Capture</button>
        </div>
        <input type="file" name="tryon[clothing_photos][]" accept="image/*" class="real-file-input" hidden>
        <div class="mode-buttons">
          <button type="button" class="mode-btn camera-style" data-mode="camera">Snap Item 📸</button>
          <button type="button" class="mode-btn upload-style active" data-mode="upload">Upload Image 🖼</button>
        </div>
      </div>
    </template>

    <%= f.submit "GENERATE MY FIT ✨", class: "primary-button" %>
  <% end %>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    var MAX_DIM = 1280;
    var MAX_CLOTHING_ITEMS = 4;

    function resizeFile(file, maxDim) {
      return new Promise(function (resolve) {
        var img = new Image();
        var reader = new FileReader();
        reader.onload = function (e) {
          img.onload = function () {
            var scale = Math.min(1, maxDim / Math.max(img.width, img.height));
            var canvas = document.createElement("canvas");
            canvas.width = Math.round(img.width * scale);
            canvas.height = Math.round(img.height * scale);
            canvas.getContext("2d").drawImage(img, 0, 0, canvas.width, canvas.height);
            canvas.toBlob(function (blob) {
              resolve(new File([blob], "photo.jpg", { type: "image/jpeg" }));
            }, "image/jpeg", 0.85);
          };
          img.src = e.target.result;
        };
        reader.readAsDataURL(file);
      });
    }

    function wireUpPhotoField(field) {
      var modeBtns = field.querySelectorAll(".mode-btn[data-mode]");
      var uploadMode = field.querySelector(".upload-mode");
      var cameraMode = field.querySelector(".camera-mode");
      var fileInput = field.querySelector(".real-file-input");
      var dropzone = field.querySelector(".dropzone");
      var preview = field.querySelector(".preview");
      var dropzoneText = field.querySelector(".dropzone-text");
      var dropzoneIcon = field.querySelector(".dropzone-icon");
      var video = field.querySelector("video");
      var canvas = field.querySelector("canvas");
      var captureBtn = field.querySelector(".capture-btn");
      var cameraPreview = field.querySelector(".camera-preview");
      var stream = null;
      var captured = false;

      modeBtns.forEach(function (btn) {
        btn.addEventListener("click", function () {
          modeBtns.forEach(function (b) { b.classList.remove("active"); });
          btn.classList.add("active");

          if (btn.dataset.mode === "upload") {
            uploadMode.style.display = "block";
            cameraMode.style.display = "none";
            stopCamera();
          } else {
            uploadMode.style.display = "none";
            cameraMode.style.display = "block";
            startCamera();
          }
        });
      });

      dropzone.addEventListener("click", function () { fileInput.click(); });
      dropzone.addEventListener("dragover", function (e) {
        e.preventDefault();
        dropzone.classList.add("dragover");
      });
      dropzone.addEventListener("dragleave", function () {
        dropzone.classList.remove("dragover");
      });
      dropzone.addEventListener("drop", function (e) {
        e.preventDefault();
        dropzone.classList.remove("dragover");
        if (e.dataTransfer.files.length) handleFile(e.dataTransfer.files[0]);
      });

      fileInput.addEventListener("change", function () {
        if (fileInput.files.length) handleFile(fileInput.files[0]);
      });

      function handleFile(file) {
        resizeFile(file, MAX_DIM).then(function (resized) {
          var dt = new DataTransfer();
          dt.items.add(resized);
          fileInput.files = dt.files;
          showPreview(resized);
        });
      }

      function showPreview(file) {
        var reader = new FileReader();
        reader.onload = function (e) {
          preview.src = e.target.result;
          preview.style.display = "block";
          dropzoneText.style.display = "none";
          if (dropzoneIcon) dropzoneIcon.style.display = "none";
        };
        reader.readAsDataURL(file);
      }

      function startCamera() {
        navigator.mediaDevices.getUserMedia({ video: { facingMode: "environment" } })
          .then(function (s) {
            stream = s;
            video.srcObject = s;
          })
          .catch(function (err) {
            alert("Could not access camera: " + err.message);
          });
      }

      function stopCamera() {
        if (stream) {
          stream.getTracks().forEach(function (t) { t.stop(); });
          stream = null;
        }
      }

      captureBtn.addEventListener("click", function () {
        if (!captured) {
          var scale = Math.min(1, MAX_DIM / Math.max(video.videoWidth, video.videoHeight));
          canvas.width = Math.round(video.videoWidth * scale);
          canvas.height = Math.round(video.videoHeight * scale);
          canvas.getContext("2d").drawImage(video, 0, 0, canvas.width, canvas.height);

          canvas.toBlob(function (blob) {
            var file = new File([blob], "capture.jpg", { type: "image/jpeg" });
            var dt = new DataTransfer();
            dt.items.add(file);
            fileInput.files = dt.files;
          }, "image/jpeg", 0.9);

          cameraPreview.src = canvas.toDataURL("image/jpeg");
          cameraPreview.style.display = "block";
          video.style.display = "none";
          captureBtn.textContent = "Retake";
          captured = true;
          stopCamera();
        } else {
          cameraPreview.style.display = "none";
          video.style.display = "block";
          captureBtn.textContent = "Capture";
          captured = false;
          startCamera();
        }
      });

      field._cleanupCamera = stopCamera;
    }

    wireUpPhotoField(document.getElementById("person-photo-field"));

    var useSavedBtn = document.getElementById("use-saved-btn");
    var useNewBtn = document.getElementById("use-new-btn");
    var sourceInput = document.getElementById("person_photo_source");
    var savedPreview = document.getElementById("saved-photo-preview");
    var personField = document.getElementById("person-photo-field");

    if (useSavedBtn && useNewBtn) {
      useSavedBtn.addEventListener("click", function () {
        useSavedBtn.classList.add("active");
        useNewBtn.classList.remove("active");
        sourceInput.value = "saved";
        savedPreview.style.display = "block";
        personField.style.display = "none";
      });

      useNewBtn.addEventListener("click", function () {
        useNewBtn.classList.add("active");
        useSavedBtn.classList.remove("active");
        sourceInput.value = "new";
        savedPreview.style.display = "none";
        personField.style.display = "block";
      });
    }

    var container = document.getElementById("clothing-items");
    var template = document.getElementById("clothing-item-template");
    var addBtn = document.getElementById("add-item-btn");

    function addClothingItem() {
      if (container.children.length >= MAX_CLOTHING_ITEMS) return;

      var clone = template.content.firstElementChild.cloneNode(true);
      container.appendChild(clone);
      wireUpPhotoField(clone);

      clone.querySelector(".remove-item-btn").addEventListener("click", function () {
        if (clone._cleanupCamera) clone._cleanupCamera();
        clone.remove();
        addBtn.style.display = container.children.length >= MAX_CLOTHING_ITEMS ? "none" : "inline-block";
      });

      addBtn.style.display = container.children.length >= MAX_CLOTHING_ITEMS ? "none" : "inline-block";
    }

    addClothingItem();
    addBtn.addEventListener("click", addClothingItem);
  });
</script>
